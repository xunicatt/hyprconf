{
  //root
  "layer": "top",
  "output": "DP-3",
  "height": 30,
  "margin-bottom": 5,
  "margin-top": 5,
  "spacing": 0,
  "modules-left": [
    "custom/app-menu",
    "hyprland/window",
  ],
  "modules-center": [
    "hyprland/workspaces",
  ],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "custom/timedate-music",
    "custom/toggle-aux-display",
    "custom/notification",
    "custom/power-menu",
  ],
  //left
  "hyprland/workspaces": {
    "disable-scroll": true,
  },
  "custom/app-menu": {
    "format": "Apps",
    "on-click": "~/.bin/launcher",
  },
  "custom/power-menu": {
    "format": "󰤆",
    "on-click": "~/.config/rofi/powermenu/powermenu.sh",
  },
  //center
  "hyprland/window": {
    "max-length": 32,
    "icon": true,
    "icon-size": 18,
    "format": "{title}",
    "rewrite": {
      "(.*) - Vivaldi": "Vivaldi",
      "(.*)Okular": "Okular",
      "(.*)Psst(.*)": "Spotify",
    },
  },
  //right
  "cpu": {
    "interval": 10,
    "format": "{usage:2d}% ",
    "max-length": 10,
  },
  "memory": {
    "interval": 30,
    "format": "{percentage:2d}% ",
    "max-length": 10,
  },
  "custom/timedate-music": {
    "exec": "~/.bin/timedate-music",
    "format": "{}",
    "max-length": 80,
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "interval": 1,
  },
  "pulseaudio": {
    "format": "{volume}% 󰕾",
    "format-muted": "Muted 󰖁",
    "scroll-step": 1,
    "on-click-right": "pavucontrol",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },
  "custom/toggle-aux-display": {
    "exec": "~/.bin/aux_display_status",
    "on-click": "~/.bin/aux_display_toggle",
    "format": "{} ",
    "restart-interval": 1,
  },
  "custom/notification": {
    "exec": "~/.bin/notification",
    "on-click": "dunstctl set-paused toggle",
    "restart-interval": 1,
  },
}
