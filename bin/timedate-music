time_date=$(date "+  %d/%m    %H:%M")
status=$(playerctl -p spotify status 2>/dev/null)
title=$(playerctl -p spotify metadata title 2>/dev/null | sed 's/"//g')

if [[ "$status" == "Paused" ]]; then
    echo "{\"text\": \"$time_date    $title \"}"
    exit 0
elif [[ "$status" == "Playing" ]]; then
    echo "{\"text\": \"$time_date    $title \"}"
    exit 0
fi

echo "{\"text\": \"$time_date\"}"
